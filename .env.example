# Reactor — required. https://www.reactor.inc
REACTOR_API_KEY=replace_with_your_reactor_api_key

# One AI key is required for the director layers that make input mean anything.
# OpenAI takes precedence when both are set.
OPENAI_API_KEY=replace_with_your_openai_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional model overrides.
# OPENAI_MODEL=gpt-5.6-luna
# GEMINI_MODEL=gemini-3.5-flash
